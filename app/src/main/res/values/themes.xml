<resources>
    <style name="Theme.Tether" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/tether_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="Theme.Tether.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/tether_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Tether</item>
    </style>
</resources>
